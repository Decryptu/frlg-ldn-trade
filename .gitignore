# Ignore every top-level folder, then allow back the published ones. This keeps
# scratchpad/, .venv/, captures and notes out of the repository by default.
/*/
!/frlgsim/
!/tests/
!/tools/
!/docs/
!/scripts/
# ARM sources for CLI_RUN_BUFFER_SCRIPT payloads; the assembled bytes are committed in
# frlgsim/buffer_payloads.py and these are what they must still assemble to.
!/asm/
!/config/
!/config/host.toml

# Machine-specific host settings can name local key locations and capture
# directories.  Keep them out of the deployable repository.
/config/host.local.toml
!/vendor/
!/vendor/**

# Never publish Pokemon data files (live-trade outputs can carry trainer/account
# identifiers); covers any stray .pk3/.ek3 at the root or inside frlgsim/ too.
*.pk3
*.ek3

# Nintendo Switch key material is machine-local.  This includes the normal
# ~/.switch/prod.keys location when it is copied into the project by mistake.
prod.keys
*.keys
.switch/

# Python bytecode (applies inside frlgsim/ as well)
__pycache__/
*.pyc

# Editable installs of the vendored LDN package create local packaging
# metadata beside setup.py. It is reproducible and must not block Pi updates.
*.egg-info/

# Runtime logs, protocol traces, and packet captures may contain console,
# trainer, or network identifiers and should stay local.
*.log
*.jsonl
*.pcap
*.pcapng
host-tap-*.txt
logs/
# Nested standalone clone (kinnay/LDN), a reference copy of the vendored package.
LDN/

# Saves and ROM for testing wonder cards on emulation.
frlgsim/POKEMON_FIRE_BPRE01.gba
frlgsim/POKEMON_FIRE_BPRE01.sav.gift.sav
frlgsim/POKEMON_FIRE_BPRE01.sav

# Untracked working notes.
CLAUDE.md
NOTES.history.local.md
NOTES.local.md
REFERENCES.local.md
